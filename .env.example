# Fill in locally. Never commit .env.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
BENCH_JUDGE_MODEL=deepseek-flash
BENCH_JUDGE_BASE_URL=https://api.deepseek.com
BENCH_JUDGE_API_KEY_ENV=DEEPSEEK_API_KEY
BENCH_PILOT_CASES=30
BENCH_MAX_COST_USD=5
BENCH_MAX_REQUESTS=400
BENCH_MAX_CONCURRENCY=2
BENCH_REQUEST_TIMEOUT_SECONDS=120
# Proportion of the configured total context window used as the soft compaction line.
BENCH_HISTORY_CONTEXT_RATIO=0.8

# Optional Jev Decisions adapter; separate from the DeepSeek benchmark credentials.
OPENROUTER_API_KEY=
